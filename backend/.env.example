# development | production (production enforces wss://, https CORS and non-dev secrets)
APP_ENV=development

# LiveKit SFU. Clients connect to LIVEKIT_URL directly; media never touches this API.
LIVEKIT_URL=ws://localhost:7880
# Optional server-to-server URL for RoomService (defaults to LIVEKIT_URL)
# LIVEKIT_API_URL=http://livekit:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret-not-for-production-0123456789
LIVEKIT_ROOM_ADMIN=true

# JSON list of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

HOST_TOKEN_TTL_SECONDS=600
LISTENER_TOKEN_TTL_SECONDS=300
ROOM_TTL_SECONDS=21600
ROOM_IDLE_TIMEOUT_SECONDS=300
MAX_ROOMS=1000
MAX_LISTENERS_PER_ROOM=100

RATE_LIMIT_CREATE_PER_MINUTE=10
RATE_LIMIT_TOKEN_PER_MINUTE=60
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
